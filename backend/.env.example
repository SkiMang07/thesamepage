SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
AI_SCRIBE_MODEL=claude-sonnet-5
# Dictation (talk-to-text). An OpenAI model name, not an Anthropic one —
# Claude has no audio input modality. Alternatives: gpt-4o-transcribe,
# gpt-4o-mini-transcribe. Requires OPENAI_API_KEY.
AI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
